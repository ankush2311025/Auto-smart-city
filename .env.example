# ==========================================
# AETHER-CITY DIGITAL TWIN CONFIGURATION
# ==========================================

# Backend Server Configuration
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
SQLITE_DB_PATH=./data/aether_city.db

# GenAI Copilot Configuration (Server-Side Only - Never expose keys to frontend)
# Options: demo | ollama | openai
AI_PROVIDER=demo
AI_MODEL=llama3.2
OLLAMA_BASE_URL=http://localhost:11434
EXTERNAL_LLM_API_KEY=
EXTERNAL_LLM_BASE_URL=https://api.openai.com/v1
